  spawnRotationOffset: {x: 90, y: 0, z: 180}
  minMaxZoom: {x: 0.3, y: 0.8}
  defaultZoomValue: 0.5
  objectName: "\u041B\u0438\u0447\u043D\u044B\u0439 \u0434\u043D\u0435\u0432\u043D\u0438\u043A"
  description: "\u0417\u0430\u043F\u0438\u0441\u0438 \u043E \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0445
    \u043C\u0435\u0447\u0442\u0430\u0445, \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0438\u044F\u0445, \u0441\u0442\u0440\u0430\u0445\u0430\u0445,
    \u043F\u043B\u0430\u043D\u0430\u0445 \u043D\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u0435
    \u0438 \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F\u0445.\n\r\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B \u0432\u044B\u0440\u0432\u0430\u043D\u044B:
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0442\u0430\u043C \u0431\u044B\u043B\u043E
    \u0442\u043E, \u0447\u0442\u043E \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C
    \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F.\n\u0414\u043D\u0435\u0432\u043D\u0438\u043A
    \u2014 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0441 \u0441\u043E\u0431\u043E\u0439,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u044B\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u043A\u043E\u043C\u0443"
