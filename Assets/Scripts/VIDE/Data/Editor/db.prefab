  - commentCount: 3
    s_comment:
    - text: "\u0422\u044B, \u043F\u043E\u0445\u043E\u0436\u0435, \u043D\u0430\u0448\u043B\u0430
        \u0441\u043F\u043E\u0441\u043E\u0431 \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F
        \u0441\u0432\u043E\u0438\u043C \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
        \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E\u043C"
      extraData: ExtraData
      inputSetIndex: 56
      outputNodeIndex: -1
      outActionIndex: 9
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 63
        width: 30
        height: 47
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "\u041E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E -
        \u044D\u0442\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E
        \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043B\u044E\u0434\u0435\u0439,
        \u043D\u043E \u0438 \u043F\u0440\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
        \u0431\u044B\u0442\u044C \u0432 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438
        \u0441 \u0441\u043E\u0431\u043E\u0439\r"
      extraData: ExtraData
      inputSetIndex: 56
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "\u041D\u043E \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439,
        \u0447\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0441\u0442\u043E\u0438\u0442
        \u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u0441\u0432\u043E\u0435\u0439
        \u0443\u044E\u0442\u043D\u043E\u0439 \u043F\u0435\u0449\u0435\u0440\u044B
        \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u0447\u0442\u043E
        \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0437\u0430
        \u0435\u0451 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438"
