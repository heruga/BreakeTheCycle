    - text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
        \u0432\u043C\u0435\u0441\u0442\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u0432 \u0442\u0432\u043E\u0438\u0445 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u0445"
      extraData: ExtraData
      inputSetIndex: 12
      outputNodeIndex: -1
      outActionIndex: 10
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 63
        width: 30
        height: 47
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "\u0415\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C
        \u0443\u0439\u0442\u0438, \u0442\u043E \u0441\u043B\u0435\u0432\u0430 \u043E\u0442
        \u0442\u0435\u0431\u044F - \u0432\u044B\u0445\u043E\u0434, \u0430 \u0441\u043F\u0440\u0430\u0432\u0430
        - \u0432\u0445\u043E\u0434. \u0412\u0445\u043E\u0434 \u0432\u0435\u0434\u0435\u0442
        \u0433\u043B\u0443\u0431\u0436\u0435 \u0432 \u0442\u0432\u043E\u0435 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435.
        \u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u0437\u0430\u0439\u0442\u0438
        \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u043A\u043E, \u043A\u0430\u043A
        \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u043E\u0436\u0435\u0448\u044C"
      extraData: ExtraData
      inputSetIndex: 12
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "\u0417\u0430\u0442\u0435\u043C \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0432\u043D\u043E\u0432\u044C \u043F\u0440\u0438\u0445\u043E\u0434\u0438
        \u043A\u043E \u043C\u043D\u0435, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C
        \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F.
        \u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0443 \u0437\u0434\u0435\u0441\u044C"
      extraData: ExtraData
      inputSetIndex: 12
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "\u041A\u0441\u0442\u0430\u0442\u0438, \u0441\u0437\u0430\u0434\u0438
        \u0442\u0435\u0431\u044F \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
        \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0441 \u043A\u0430\u043A\u0438\u043C\u0438
        \u044D\u043C\u043E\u0446\u0438\u044F\u043C\u0438 \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
        \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0441\u043E
        \u0441\u0432\u043E\u0438\u043C\u0438 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C\u0438.
        \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439, \u0435\u0441\u043B\u0438
        \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C \u043A\u0430\u043A-\u0442\u043E
        \u0443\u0441\u0438\u043B\u0438\u0442\u044C \u0441\u0435\u0431\u044F"
