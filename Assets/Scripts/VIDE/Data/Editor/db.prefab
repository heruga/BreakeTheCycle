      visible: 1
    - text: "\u0423\u0436\u0435 \u0437\u0430\u0431\u044B\u043B\u0430 \u043A\u0430\u043A
        \u0432 \u0448\u043A\u043E\u043B\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430?
        \u041C\u043E\u0436\u0435\u0448\u044C \u0441\u0447\u0438\u0442\u0430\u0442\u044C
        \u043C\u0435\u043D\u044F \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u0438\u0437
        \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0438 \u0442\u0432\u043E\u0438\u043C
