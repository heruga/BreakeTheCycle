  m_Name: 
  m_EditorClassIdentifier: 
  spawnPositionOffset: {x: 0, y: 0, z: 0}
  spawnRotationOffset: {x: 0, y: 180, z: 0}
  minMaxZoom: {x: 0.3, y: 0.6}
  defaultZoomValue: 0.6
  objectName: "\u041F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0432
    \u0441\u0435\u0431\u044F"
  description: "\u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0438\u0437
    \u043A\u043D\u0438\u0433\u0438:\n<i>\xAB\u0427\u0442\u043E\u0431\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
    \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0441\u0442\u0440\u0430\u0445\u0430\u043C\u0438,
    \u043D\u0443\u0436\u043D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F
    \u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0441\u0435\u0431\u044F.\r\n...\n\u041D\u0435
    \u0431\u043E\u0439\u0442\u0435\u0441\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C
    \u0441 \u0441\u043E\u0431\u043E\u0439. \u041D\u0435 \u0443\u0431\u0435\u0433\u0430\u0439\u0442\u0435
    \u043E\u0442 \u0441\u0435\u0431\u044F.\n...\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435,
    \u0447\u0442\u043E \u0432\u0430\u0448\u0438 \u0441\u0442\u0440\u0430\u0445\u0438
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u0432\u0440\u0430\u0433\u0438, \u0430
    \u0447\u0430\u0441\u0442\u0438 \u0432\u0430\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0445\u043E\u0442\u044F\u0442 \u0431\u044B\u0442\u044C \u0443\u0441\u043B\u044B\u0448\u0430\u043D\u043D\u044B\u043C\u0438.\r\n...\n\u0422\u043E\u043B\u044C\u043A\u043E
    \u043F\u0440\u0438\u043D\u044F\u0432 \u0438\u0445, \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435. 
    \n...\n\u041F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u2014 \u044D\u0442\u043E
    \u043D\u0435 \u043F\u0430\u0434\u0435\u043D\u0438\u0435, \u0430 \u043F\u0443\u0442\u044C
    \u043A \u0441\u0432\u043E\u0431\u043E\u0434\u0435\xBB</i>"
