MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4661596465956824158}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57f34671d8b3147468ee41bb4ba5549e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  spawnPositionOffset: {x: 0, y: 0, z: 0}
  spawnRotationOffset: {x: -90, y: 0, z: 0}
  minMaxZoom: {x: 0.1, y: 0.4}
  defaultZoomValue: 0.3
  objectName: "\u0422\u0430\u0431\u043B\u0435\u0442\u043A\u0438 \xAB\u0421\u0442\u0430\u0431\u0438\u043B\u0438\u0442\u043E\u043D\xBB"
  description: "\u041F\u0443\u0441\u0442\u043E\u0439 \u0431\u0443\u0442\u044B\u043B\u0435\u043A
    \u0442\u0430\u0431\u043B\u0435\u0442\u043E\u043A.\n\n\u041D\u0430\u0434\u043F\u0438\u0441\u044C
    \u043D\u0430 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0435: \xAB\u0421\u0442\u0430\u0431\u0438\u043B\u0438\u0442\u043E\u043D.
    \u0414\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F
    \u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0441\u0442\u0438\xBB\n\r\n<i>\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435!
    \n\u0418\u043C\u0435\u044E\u0442\u0441\u044F \u043F\u043E\u0431\u043E\u0447\u043D\u044B\u0435
    \u044D\u0444\u0444\u0435\u043A\u0442\u044B. \u041D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0439\u0442\u0435\u0441\u044C
    \u0441\u0430\u043C\u043E\u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C. \u041D\u0435
    \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443
    \u0431\u043B\u0438\u0437\u043A\u0438\u0445 \u0438 \u0440\u0430\u0431\u043E\u0442\u0443
    \u0441 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u043E\u043C.</i>"
  nameColor: {r: 0, g: 0, b: 0, a: 1}
  descriptionColor: {r: 0, g: 0, b: 0, a: 1}
  nameFontSize: 36
  descriptionFontSize: 28
  objectToActivate: {fileID: 0}
