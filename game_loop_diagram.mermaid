graph TD
    A0(["Начало игровой сессии"]) --> A1["Пространство «Реальность»\n- Исследование фиксированной локации\n- Взаимодействие с объектами (монологи)\n- Принятие решения о переходе"];
    A1 --> A2["Переход в пространство «Сознание»"];
    A2 --> A3["Выбор активных Эмоций\n(определение характеристик на забег)"];
    A3 --> A4["Запуск сессии в «Сознание»"];

    A4 --> CORE_LOOP_ENTRY;

    subgraph CORE_LOOP [Основной игровой цикл в «Сознании»]
        direction TB
        CORE_LOOP_ENTRY[" "] -.-> C1["(А) Прохождение текущей комнаты\n(см. детализацию ниже)"];
        C1 --> C_D1{"Игрок погиб в «Сознании» / Завершил цели забега (босс)?"};
        C_D1 -- "Нет (продолжить забег)" --> C1;
    end
    
    C_D1 -- "Да (забег окончен: смерть/победа)" --> A6["Сохранение «Фрагментов себя» (валюты)"];
    A6 --> A7["Мета-прогрессия\n(в «Реальности» или хабе)\n- Улучшение Эмоций\n- Увеличение числа активных Эмоций"];
    A7 --> A1; % Цикл возвращается в Реальность
    A7 --> A8(["Конец игровой сессии\n(выход из игры / сюжет завершен)"]);

    %% Детализация блока (А) Прохождение комнаты в «Сознании»
    %% Этот блок описывает, что происходит внутри узла C1
    subgraph DETAIL_A [Детализация: (А) Прохождение комнаты в «Сознании»]
        direction TB
        DA_START["Вход в процедурно-сгенерированную комнату"] --> DA1["Исследование комнаты и взаимодействие:\n- Объекты окружения (монологи, информация)\n- Диалоги с NPC-проводником"];
        DA1 --> DA_D1{"Комната боевая?"};
        
        DA_D1 -- "Да" --> DA2["Сражение с врагами\n(используя эффекты выбранных Эмоций)"];
        DA2 --> DA_D2{"Победа над всеми врагами?"};
        DA_D2 -- "Да" --> DA3["Сбор «Фрагментов себя»\nОткрытие портала в следующую комнату"];
        DA3 --> DA_END_SUCCESS["--> к C_D1 (не погиб, комната пройдена)"];
        
        DA_D2 -- "Нет (здоровье = 0)" --> DA4["Игрок погиб в комнате"];
        DA4 --> DA_END_DEATH["--> к C_D1 (погиб)"];
        
        DA_D1 -- "Нет (сюжетная/исследовательская и т.п.)" --> DA5["Выполнение условий комнаты\n(решение головоломки, завершение диалога и т.д.)"];
        DA5 --> DA6["Открытие портала в следующую комнату"];
        DA6 --> DA_END_SUCCESS;
    end 