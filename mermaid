    %% Relationships - Composition (strong ownership)
    GameManager *-- ScreenFader : использует
    DungeonGenerator *-- RoomNode : создает
    DungeonGenerator *-- RoomManager : управляет
    ObjectInspector *-- InspectionCamera : контролирует
    ObjectInspector *-- InspectionWindowUI : контролирует
    RoomManager *-- EnemyController : создает и управляет

    %% Relationships - Aggregation (weak ownership)
    EmotionPanelInteractable o-- EmotionSystem : ссылается
    InspectableObject o-- DialogueNodeEnqueuer : ссылается
    InteractableObject o-- MonologueTriggerData : ссылается
    DungeonGenerator o-- DungeonConfigSO : настраивается с помощью
    DungeonGenerator o-- RoomTemplateSO : использует шаблоны
    DungeonGenerator o-- EnemyConfigSO : создает врагов с помощью
    DungeonGenerator o-- LootTableSO : создает награды с помощью
    EmotionSystem o-- ToolTipManager : использует всплывающие подсказки
    ToolTip o-- ToolTipManager : использует менеджер показа/скрытия
    NPCDialogueInteract o-- DialogueStartNodeQueue : ставит диалоги в очередь
    InteractablePortal o-- RoomManager : проверяет статус очистки комнаты
    InteractablePortal o-- DungeonGenerator : загружает комнаты

    %% Relationships - Association (uses)
    GameManager --> CurrencyManager : инициализирует
    GameManager --> MonologueManager : запускает монологи
    CurrencyUI --> CurrencyManager : подписывается на
    CurrencyPrefab --> CurrencyManager : ссылается
    DungeonGenerator --> RoomTypeSO : назначает типы
    EmotionSystem --> ConsciousnessController : влияет на
    MonologueManager --> GameManager : уведомляет
    DialogueActions --> GameManager : управляет переключением миров
    DialogueActions --> DialogueStartNodeQueue : ставит диалоги в очередь
    DialogueNodeEnqueuer --> DialogueStartNodeQueue : добавляет узлы в очередь
    ObjectInspector --> MonologueManager : воспроизводит монологи
    InteractableObject --> MonologueManager : воспроизводит монологи
    EmotionPanelInteractable --> PlayerControlManager : управляет вводом игрока
    ObjectInspector --> PlayerControlManager : отключает управление при осмотре
    PauseMenuUI --> PlayerControlManager : переключает управление игрока
    PauseMenuUI --> GameManager : сохраняет игру
    LongHoldHandler --> ToolTipManager : скрывает подсказки при нажатии
    InteractionPromptUI --> InspectableObject : показывает подсказку для осмотра
    MenuButtonHandler --> GameManager : вызывает методы состояния игры
    MainMenuCursor --> PauseMenuUI : управление курсором
    NPCDialogueInteract --> MonologueManager : запускает события диалога
    NPCDialogueInteract --> DialogueStartNodeQueue : управляет очередями диалогов
    PlayerHealth --> EmotionSystem : модифицирует получаемый урон
    PlayerHealth --> GameManager : обрабатывает смерть и возрождение игрока
    EnemyHealth --> EnemyController : запускает анимации
    EnemyHealth --> RoomManager : уведомляет комнату о смерти врага
    EnemyController --> PlayerHealth : наносит урон игроку
    ConsciousnessController --> PlayerHealth : управляет здоровьем игрока
    ConsciousnessController --> PlayerControlManager : получает изменения состояния управления
    ConsciousnessController --> EmotionSystem : модифицирует боевые характеристики
    ConsciousnessController --> RoomManager : получает уведомления о смене комнат
    ConsciousnessController --> Animator : запускает анимации
    RealityPlayerController --> FirstPersonCameraController : синхронизирует движение камеры
    RealityPlayerController --> PlayerControlManager : получает изменения состояния управления
    RealityPlayerController --> IInteractable : обнаруживает и взаимодействует с объектами
    RealityPlayerController --> MonologueManager : запускает монолог первого движения
    RealityPlayerController --> MonologueTriggerData : получает ID монолога
    InteractablePortal --> GameManager : переключает миры